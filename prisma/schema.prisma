// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  ADMIN
  SPECIALIST
  SECRETARY
  MANAGER
}

// Institución/clínica. institutionId en User y Professional queda nullable
// para siempre (null = sin asignar, solo visible/gestionable por ADMIN).
model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  professionals Professional[]
  healthInsurances HealthInsurance[]
  transactions  Transaction[]
}

// Obra social que una institución acepta. Configurable por Encargado (la
// suya) o Admin (cualquiera) — alimenta el desplegable de "Mi perfil" del
// paciente.
model HealthInsurance {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, name])
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())

  // Sólo tiene sentido para pacientes; se completan desde "Mi perfil".
  healthInsurance       String?
  healthInsuranceNumber String?

  // Solo tiene sentido para MANAGER y SECRETARY (a qué institución pertenecen).
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  appointments Appointment[]
  professional Professional?

  documents         PatientDocument[] @relation("PatientDocuments")
  uploadedDocuments PatientDocument[] @relation("UploadedDocuments")

  antecedents PatientAntecedents?

  invoicesReceived Invoice[]     @relation("InvoicePatient")
  invoicesIssued   Invoice[]     @relation("InvoiceIssuedBy")
  transactionsLogged Transaction[]

  @@index([institutionId])
}

// Antecedentes clínicos del paciente: no cambian por turno, los edita
// cualquier especialista que lo atienda. Núcleo de la HCE (Fase 2).
model PatientAntecedents {
  id                 String   @id @default(cuid())
  patientId          String   @unique
  allergies          String?
  chronicConditions  String?
  currentMedications String?
  notes              String?
  updatedAt          DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Evolución de una consulta puntual — a lo sumo una por turno.
model ClinicalNote {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  reason        String?
  diagnosis     String?
  notes         String?
  treatment     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Resultado/informe (labo, imágenes, etc.) que un miembro del staff sube
// para que el paciente lo vea desde su portal. Portal de consulta al
// paciente (Fase 1 del roadmap) — precursor mínimo de la HCE (Fase 2).
model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  title        String
  fileName     String
  mimeType     String
  storagePath  String
  uploadedById String?
  createdAt    DateTime @default(now())

  patient    User  @relation("PatientDocuments", fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([patientId])
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  professionals ProfessionalSpecialty[]
}

model Professional {
  id        String   @id @default(cuid())
  fullName  String
  bio       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  mp        String? // Matrícula Profesional (provincial)
  mn        String? // Matrícula Nacional
  dni       String?
  birthDate DateTime?

  // Link opcional a un login propio (rol SPECIALIST). Null = el profesional
  // todavía no tiene acceso a su portal, solo lo gestiona el admin.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  bookingMessage          String?
  cancelMessage           String?
  whatsappMessageTemplate String?

  mercadoPagoConnected Boolean @default(false)
  depositAmount        Int?
  feeAmount            Int? // Honorario por turno atendido, para liquidación.
  consultingRoom       String? // Ej: "Consultorio 3" — para la pantalla de llamador.

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  specialties  ProfessionalSpecialty[]
  schedules    ScheduleSlot[]
  appointments Appointment[]
  extraDays    ExtraDay[]
  licenses     License[]

  @@index([institutionId])
}

// Tabla intermedia N:M entre Professional y Specialty
model ProfessionalSpecialty {
  professionalId String
  specialtyId    String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([professionalId, specialtyId])
}

// Plantilla semanal recurrente de disponibilidad de un profesional
// (ej: Lunes 09:00-12:00, turnos de 30 min)
model ScheduleSlot {
  id             String @id @default(cuid())
  professionalId String
  dayOfWeek      Int // 0=domingo .. 6=sábado
  startTime      String // "09:00"
  endTime        String // "12:00"
  slotMinutes    Int    @default(30)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

// "Día adicional": disponibilidad puntual para una fecha específica,
// sin tocar el ScheduleSlot semanal recurrente.
// `date` siempre se normaliza a medianoche local antes de guardar
// (mismo criterio que `rangeStart` en lib/availability.ts).
model ExtraDay {
  id             String   @id @default(cuid())
  professionalId String
  date           DateTime
  startTime      String
  endTime        String
  slotMinutes    Int      @default(30)
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
}

// "Licencia": bloquea toda la agenda del profesional en un rango de fechas
// (ej. vacaciones). startDate/endDate siempre normalizados a medianoche local.
model License {
  id             String   @id @default(cuid())
  professionalId String
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startDate, endDate])
}

// Turno concreto reservado por un paciente
model Appointment {
  id             String            @id @default(cuid())
  professionalId String
  patientId      String
  date           DateTime
  status         AppointmentStatus @default(BOOKED)
  arrivedAt      DateTime?
  calledAt       DateTime?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])
  patient      User         @relation(fields: [patientId], references: [id])

  clinicalNote ClinicalNote?
  invoice      Invoice?

  @@index([professionalId, date])
  @@index([patientId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Caja: ingresos/egresos cargados a mano por el staff. No hay conciliación
// automática con Mercado Pago todavía porque esa integración es una
// simulación (ver Professional.mercadoPagoConnected) sin webhooks reales.
model Transaction {
  id            String          @id @default(cuid())
  institutionId String?
  type          TransactionType
  concept       String
  amount        Int
  date          DateTime        @default(now())
  createdById   String?
  createdAt     DateTime        @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id])
  createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([institutionId, date])
}

// Comprobante interno, NO es una factura electrónica de AFIP: emitir
// facturas fiscales de verdad requiere CUIT + certificado digital +
// homologación de punto de venta (WSFE) que este sistema todavía no tiene
// configurado. Sirve como recibo para el paciente mientras tanto.
model Invoice {
  id             String   @id @default(cuid())
  appointmentId  String?  @unique
  patientId      String
  concept        String
  amount         Int
  createdById    String?
  createdAt      DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  patient     User         @relation("InvoicePatient", fields: [patientId], references: [id])
  createdBy   User?        @relation("InvoiceIssuedBy", fields: [createdById], references: [id])
}
